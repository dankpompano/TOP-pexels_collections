<%= form_with url: root_path, method: :get do |form| %>
  <p>
    <%=form.label "Collections ID"%>
    <%=form.text_field :collections_id%>
  </p>
  
  <% if @collection.present? %>
    <% @collection["media"].each do |image| %>
      <img src="<%= image["src"]["medium"] %>" alt="<%= image["alt"] %>">
    <% end %>
  <% end %>
  <%=form.submit "Submit"%>
<% end %>
